<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             Title="Hospedagem Contratada"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <VerticalStackLayout Padding="10"
                         VerticalOptions="Center"
                         Spacing="10">

        <Label x:Name="lbl_suite"
               Text="Suíte"
               TextColor="#24476B"
               FontFamily="Kalam"
               FontSize="35"
               HorizontalTextAlignment="Center"/>

        <Frame Margin="5" Padding="15"
               BackgroundColor="#386F9E">
            <HorizontalStackLayout HorizontalOptions="Center"
                                   Spacing="25">

                <VerticalStackLayout>
                    <Label Text="Adultos:"
                           TextColor="White"/>
                    <Label x:Name="lbl_adultos"
                           TextColor="White"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <VerticalStackLayout>
                    <Label Text="Crianças:"
                           TextColor="White"/>
                    <Label x:Name="lbl_criancas"
                           TextColor="White"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

            </HorizontalStackLayout>
        </Frame>

        <Frame Margin="5" Padding="15"
               BackgroundColor="#386F9E">
            <Grid ColumnDefinitions="*, *, *"
                  RowDefinitions="Auto, Auto"
                  ColumnSpacing="5">

                <Label Grid.Row="0" Grid.Column="0"
                       Text="Check-in:"
                       FontAttributes="Bold"
                       TextColor="White"/>

                <Label Grid.Row="0" Grid.Column="1"
                       Text="Check-out:"
                       FontAttributes="Bold"
                       TextColor="White"/>

                <Label Grid.Row="0" Grid.Column="2"
                       Text="Estadia:"
                       FontAttributes="Bold"
                       TextColor="White"/>

                <Label x:Name="lbl_checkin"
                       Grid.Row="1" Grid.Column="0"
                       TextColor="White"/>

                <Label x:Name="lbl_checkout"
                       Grid.Row="1" Grid.Column="1"
                       TextColor="White"/>

                <Label x:Name="lbl_estadia"
                       Grid.Row="1" Grid.Column="2"
                       TextColor="White"/>

            </Grid>
        </Frame>

        <Frame Margin="5" Padding="15"
               BackgroundColor="#386F9E">
            <VerticalStackLayout HorizontalOptions="Center">

                <Label Text="Valor Total:"
                       FontAttributes="Bold"
                       FontSize="18"
                       TextColor="White"/>

                <Label x:Name="lbl_valor_total"
                       FontSize="24"
                       TextColor="White"
                       FontAttributes="Bold"/>

            </VerticalStackLayout>
        </Frame>

        <Button Text="Voltar"
                HorizontalOptions="Center"
                Clicked="Button_Clicked"
                BackgroundColor="#24476B"
                TextColor="White"/>

    </VerticalStackLayout>

</ContentPage>