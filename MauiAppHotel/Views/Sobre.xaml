<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Sobre"
             Title="Sobre"
             BackgroundColor="#F2F5FA">

    <VerticalStackLayout Padding="30"
                         Spacing="20"
                         VerticalOptions="Center">
                        
        <Label Text="SOBRE O APLICATIVO"
               FontSize="28"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               TextColor="#24476B"/>
        

        <BoxView HeightRequest="2"
                 Color="#24476B"/>

        <Label Text="Desenvolvedor:"
           FontAttributes="Bold"
           FontSize="18"
           HorizontalOptions="Center"
           TextColor="CadetBlue"/>


        <Label Text="Vitor Antonio de Campos Carvalho"
               FontSize="16"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               TextColor="#555555"/>

        <Label Text="Ano de desenvolvimento: 2026"
               FontSize="16" 
               HorizontalOptions="Center"
               TextColor="#555555"/>

    </VerticalStackLayout>

</ContentPage>